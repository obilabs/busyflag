{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Busyflag",
  "version": "0.1.0",
  "identifier": "com.busyflag.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Busyflag",
        "url": "index.html",
        "width": 520,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Free/busy light for Luxafor Flag",
    "longDescription": "Turns a Luxafor Flag red while any application is using the microphone (optionally the camera) and green when free.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "files": {
          "/usr/lib/udev/rules.d/70-busyflag.rules": "../linux/70-busyflag.rules"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
